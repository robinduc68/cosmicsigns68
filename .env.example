# ---------------------------------------------------------------------------
# Cosmic Signs — copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO
DEBUG=false

# Ports (defaults avoid the common 3000/5432/6379 collisions) ---------------
WEB_PORT=3100
API_PORT=8100
POSTGRES_PORT=5436
REDIS_PORT=6382

# Database ------------------------------------------------------------------
POSTGRES_USER=cosmic
POSTGRES_PASSWORD=cosmic
POSTGRES_DB=cosmic_signs
DATABASE_URL=postgresql+asyncpg://cosmic:cosmic@localhost:5436/cosmic_signs

# Cache / jobs (not used yet — see docs/architecture.md) --------------------
REDIS_URL=redis://localhost:6382/0

# API -----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3100
# FRAME   = only fully verified calculations, no stars
# PREVIEW = frame + provisional 14 chính tinh, labelled in the UI
CHART_ENGINE_STAGE=PREVIEW

# Web -----------------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:8100
NUXT_PUBLIC_SITE_URL=http://localhost:3100

# Not wired up yet. Present so deployment configuration is complete from day 1.
# The application must start and work with every value below left empty.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=
AI_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET=
